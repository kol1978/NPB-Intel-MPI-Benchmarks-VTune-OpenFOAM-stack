# === PETSc 3.20.x из исходников: Clang 17 (ROCm) + кастомный OpenMPI 4.1.5 ===

# 0. Контроль окружения
echo "CC будут использованы: $(which mpicc), $(which clang)"
echo "ROCM_PATH=$ROCM_PATH  MPI_PATH=$MPI_PATH"

# 1. Скачать и распаковать
