# 2. Компиляторы clang из ROCm, MPI — только наш (mpicc из PATH)
export PATH="$MPI_PATH/bin:$ROCM_PATH/llvm/bin:$PATH"
export CC="$ROCM_PATH/llvm/bin/clang"
export CXX="$ROCM_PATH/llvm/bin/clang++"

# 3. Конфигурация
python3 ./configure \
  --prefix="$HOME/OpenFOAM/petsc-3.20.6-clang" \
  --with-cc="$CC" --with-cxx="$CXX" --with-fc=0 \
  --with-mpi-dir="$MPI_PATH" --with-mpi=1 \
  --with-shared-libraries=1 \
  --with-debugging=0 \
  --download-f2cblaslapack=1

# 4. Сборка и установка (пути PETSC_DIR/PETSC_ARCH configure подскажет в конце)
make all -j"$(nproc)"
make install

# 5. Окружение — добавить в ~/.bashrc
cat >> ~/.bashrc <<'EOF'

# PETSc 3.20.6 (clang/OpenMPI)
export PETSC_DIR=$HOME/OpenFOAM/petsc-3.20.6-clang
export PKG_CONFIG_PATH=$PETSC_DIR/lib/pkgconfig:$PKG_CONFIG_PATH
EOF

Пояснения по флагам:

--with-fc=0 — компилятора Fortran у clang-тулчейна нет, и он не нужен, если PETSc используется из C/C++.
--download-f2cblaslapack=1 — PETSc сам соберёт эталонные BLAS/LAPACK тем же clang'ом. Альтернатива: --with-blas-lapack-lib=-lopenblas с установленным libopenblas-dev (быстрее, но добавляет внешнюю зависимость в ABI-цепочку).
Установка в отдельный префикс -clang — как у тебя с umpire и ompi: версии окружений не путаются.
