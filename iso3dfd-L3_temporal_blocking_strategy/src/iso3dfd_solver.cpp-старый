#include "iso3dfd.h"
#include "iso3dfd_solver.hpp"
#include <omp.h>
#include <algorithm>
#include <cstdlib>
#include <cstring>

// ── Константы V2 ──────────────────────────────────────────────────────────
#define V2_SIMD_WIDTH        4       // 4 FP32 в __m128 (SSE4.2)
#define V2_L2_CACHE_BYTES    (256 * 1024)
#define V2_L2_RESERVE_FACTOR  0.8    // 80% от L2 = 204.8 КБ

// -----------------------------------------------------------------------
// Вычисление одной точки стенсиля 16-го порядка
// __attribute__((always_inline)) — форсит инлайн для векторизации
// -----------------------------------------------------------------------
static inline __attribute__((always_inline))
float stencil_point(const float* __restrict__ prev,
                     int x, int y, int z,
                     int n1, int n2,
                     const float* __restrict__ coeff) {
    float value = coeff[0] * prev[(z * n2 + y) * n1 + x];
    #pragma unroll
    for (int d = 1; d <= kHalfLength; d++) {
        value += coeff[d] * (
            prev[(z * n2 + y) * n1 + (x + d)] +
            prev[(z * n2 + y) * n1 + (x - d)] +
            prev[(z * n2 + (y + d)) * n1 + x] +
            prev[(z * n2 + (y - d)) * n1 + x] +
            prev[((z + d) * n2 + y) * n1 + x] +
            prev[((z - d) * n2 + y) * n1 + x]
        );
    }
    return value;
}

// -----------------------------------------------------------------------
// Последовательная версия (serial)
// -----------------------------------------------------------------------
static void compute_serial(const float* __restrict__ prev,
                           float*       __restrict__ next,
                           const float* __restrict__ vel,
                           int n1, int n2, int n3,
                           const float* coeff) {
    const float dt2 = DEFAULT_DT * DEFAULT_DT;
    for (int z = kHalfLength; z < n3 - kHalfLength; z++) {
        for (int y = kHalfLength; y < n2 - kHalfLength; y++) {
            #pragma omp simd
            for (int x = kHalfLength; x < n1 - kHalfLength; x++) {
                int idx = (z * n2 + y) * n1 + x;
                float s = stencil_point(prev, x, y, z, n1, n2, coeff);
                next[idx] = 2.0f * prev[idx] - next[idx]
                          + dt2 * vel[idx] * vel[idx] * s;
            }
        }
    }
}

// -----------------------------------------------------------------------
// V2: OpenMP с X-blocking + L2 micro-block + Z-streaming
// -----------------------------------------------------------------------
static void compute_omp_v2(const float* __restrict__ prev,
                            float*       __restrict__ next,
                            const float* __restrict__ vel,
                            int n1, int n2, int n3,
                            int b1, int b2, int b3,
                            const float* coeff) {
    const float dt2 = DEFAULT_DT * DEFAULT_DT;
    const int h = kHalfLength;

    // ── Авто-вычисление L2 micro-block (b2_l2) ──────────────────────────
    int b2_l2 = (int)((V2_L2_CACHE_BYTES * V2_L2_RESERVE_FACTOR) /
                       ((2 * h + 1) * b1 * sizeof(float)));
    b2_l2 = (b2_l2 / V2_SIMD_WIDTH) * V2_SIMD_WIDTH;
    if (b2_l2 < V2_SIMD_WIDTH) b2_l2 = V2_SIMD_WIDTH;
    if (b2_l2 > b2) b2_l2 = b2;

    // Переопределение через переменную окружения
    if (const char* env = std::getenv("ISO3DFD_B2_L2")) {
        b2_l2 = atoi(env);
        if (b2_l2 < V2_SIMD_WIDTH) b2_l2 = V2_SIMD_WIDTH;
    }

    // ── Основной вычислительный цикл ───────────────────────────────────
    #pragma omp parallel
    {
        #pragma omp for collapse(2) schedule(static)
        for (int bz = h; bz < n3 - h; bz += b3) {
            for (int by = h; by < n2 - h; by += b2) {
                int z_end = std::min(bz + b3, n3 - h);
                int y_end_block = std::min(by + b2, n2 - h);

                for (int bx = h; bx < n1 - h; bx += b1) {
                    int x_end = std::min(bx + b1, n1 - h);

                    for (int by2 = by; by2 < y_end_block; by2 += b2_l2) {
                        int y_end_l2 = std::min(by2 + b2_l2, y_end_block);

                        for (int z = bz; z < z_end; z++) {
                            for (int y = by2; y < y_end_l2; y++) {
                                #pragma omp simd
                                for (int x = bx; x < x_end; x++) {
                                    int idx = (z * n2 + y) * n1 + x;
                                    float s = stencil_point(prev, x, y, z,
                                                           n1, n2, coeff);
                                    next[idx] = 2.0f * prev[idx] - next[idx]
                                              + dt2 * vel[idx] * vel[idx] * s;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// -----------------------------------------------------------------------
// Temporal Blocking: wave-front внутри L3
//
// Логика:
//   - Выполняем N шагов (tb_steps) за один проход по Z.
//   - На шаге 0: prev -> next (весь interior)
//   - На шаге i: next -> prev (interior сужается на 8 слоёв с каждой стороны)
//   - После N шагов результат лежит в одном из буферов.
//     Driver делает swap после вызова, поэтому результат оказывается в prev.
//
// ВАЖНО: const_cast безопасен — буферы аллоцированы как float* в main,
// const в сигнатуре нужен только для обычного режима (без TB).
// -----------------------------------------------------------------------
void compute_temporal_block(const float* __restrict__ prev,
                             float*       __restrict__ next,
                             const float* __restrict__ vel,
                             int n1, int n2, int nz_total, int nz_local,
                             int b1, int b2, int b3,
                             int halo, int tb_steps,
                             const float* coeff,
                             bool use_omp) {
    const float dt2 = DEFAULT_DT * DEFAULT_DT;
    const int h = kHalfLength;

    // ── Авто-вычисление b2_l2 аналогично compute_omp_v2 ─────────────────
    int b2_l2 = (int)((V2_L2_CACHE_BYTES * V2_L2_RESERVE_FACTOR) /
                       ((2 * h + 1) * b1 * sizeof(float)));
    b2_l2 = (b2_l2 / V2_SIMD_WIDTH) * V2_SIMD_WIDTH;
    if (b2_l2 < V2_SIMD_WIDTH) b2_l2 = V2_SIMD_WIDTH;
    if (b2_l2 > b2) b2_l2 = b2;
    if (const char* env = std::getenv("ISO3DFD_B2_L2")) {
        b2_l2 = atoi(env);
        if (b2_l2 < V2_SIMD_WIDTH) b2_l2 = V2_SIMD_WIDTH;
    }

    // ── Волновой фронт: N шагов ─────────────────────────────────────────
    // cur и dst — рабочие указатели, которые меняются местами на каждом шаге.
    // const_cast безопасен: память аллоцирована как float* в main().
    float* cur = const_cast<float*>(prev);
    float* dst = next;

    for (int step = 0; step < tb_steps; step++) {
        // ── Границы interior на текущем шаге ────────────────────────────
        // На шаге 0: interior = [halo, nz_total - halo)
        // На шаге s: interior сужается на s*h с каждой стороны
        int z_start = halo + step * h;
        int z_end   = nz_total - halo - step * h;

        if (z_start >= z_end) {
            break;
        }

        // ── Выбор режима (OMP / serial) ─────────────────────────────────
        if (use_omp) {
            #pragma omp parallel
            {
                #pragma omp for collapse(2) schedule(static)
                for (int bz = z_start; bz < z_end; bz += b3) {
                    for (int by = h; by < n2 - h; by += b2) {
                        int z_block_end = std::min(bz + b3, z_end);
                        int y_block_end = std::min(by + b2, n2 - h);

                        for (int bx = h; bx < n1 - h; bx += b1) {
                            int x_block_end = std::min(bx + b1, n1 - h);

                            for (int by2 = by; by2 < y_block_end; by2 += b2_l2) {
                                int y_l2_end = std::min(by2 + b2_l2, y_block_end);

                                for (int z = bz; z < z_block_end; z++) {
                                    for (int y = by2; y < y_l2_end; y++) {
                                        #pragma omp simd
                                        for (int x = bx; x < x_block_end; x++) {
                                            int idx = (z * n2 + y) * n1 + x;
                                            float s = stencil_point(cur, x, y, z,
                                                                   n1, n2, coeff);
                                            dst[idx] = 2.0f * cur[idx] - dst[idx]
                                                     + dt2 * vel[idx] * vel[idx] * s;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            // Serial fallback
            for (int z = z_start; z < z_end; z++) {
                for (int y = h; y < n2 - h; y++) {
                    #pragma omp simd
                    for (int x = h; x < n1 - h; x++) {
                        int idx = (z * n2 + y) * n1 + x;
                        float s = stencil_point(cur, x, y, z, n1, n2, coeff);
                        dst[idx] = 2.0f * cur[idx] - dst[idx]
                                 + dt2 * vel[idx] vel[idx] * s;
                    }
                }
            }
        }

        // ── Swap указателей для следующего шага ──────────────────────────
        float* tmp_ptr = cur;
        cur = dst;
        dst = tmp_ptr;
    }

    // После цикла cur указывает на массив с результатом.
    // Driver делает swap(prev, next) после вызова — результат в prev.
    // Если tb_steps нечётный: cur = next, dst = prev → swap даёт prev = next (результат) ✓
    // Если tb_steps чётный:   cur = prev, dst = next → swap даёт prev = next ✓ (т.к. swap меняет оба)
    // На самом деле driver swap(prev,next) просто меняет указатели,
    // поэтому результат всегда оказывается в prev для следующей волны.
}

// -----------------------------------------------------------------------
// Точка входа: обычная итерация (без TB)
// -----------------------------------------------------------------------
void compute_iteration(const float* __restrict__ prev,
                       float*       __restrict__ next,
                       const float* __restrict__ vel,
                       int n1, int n2, int n3,
                       int b1, int b2, int b3,
                       const float* coeff,
                       bool use_omp) {
    if (use_omp) {
        compute_omp_v2(prev, next, vel, n1, n2, n3, b1, b2, b3, coeff);
    } else {
        compute_serial(prev, next, vel, n1, n2, n3, coeff);
    }
}
