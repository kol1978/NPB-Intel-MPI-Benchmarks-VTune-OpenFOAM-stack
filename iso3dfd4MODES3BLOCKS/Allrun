#!/bin/bash
set -e

BINARY_1="./build/iso3dfd"
BINARY_2="./build-vtune-hotspots/iso3dfd"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG="iso3dfd_rerun_${TIMESTAMP}.log"

echo "========================================" | tee "$LOG"
echo "iso3dfd — повтор всех запусков" | tee -a "$LOG"
echo "Дата: $(date '+%Y-%m-%d %H:%M:%S')" | tee -a "$LOG"
echo "Сервер: $(hostname)" | tee -a "$LOG"
echo "========================================" | tee -a "$LOG"
echo "" | tee -a "$LOG"

# Функция очистки окружения
clean_env() {
    unset OMP_NUM_THREADS
    unset OMP_PROC_BIND
    unset OMP_PLACES
    unset I_MPI_PIN
    unset I_MPI_PIN_DOMAIN
    unset I_MPI_PIN_ORDER
    unset I_MPI_PIN_CELL
    unset KMP_AFFINITY
    unset KMP_HW_SUBSET
}

# Функция запуска с логированием
run_test() {
    local label="$1"
    echo "========================================" | tee -a "$LOG"
    echo ">>> $label" | tee -a "$LOG"
    echo "--- Переменные окружения ---" | tee -a "$LOG"
    echo "OMP_NUM_THREADS=${OMP_NUM_THREADS:-<unset>}" | tee -a "$LOG"
    echo "OMP_PROC_BIND=${OMP_PROC_BIND:-<unset>}" | tee -a "$LOG"
    echo "OMP_PLACES=${OMP_PLACES:-<unset>}" | tee -a "$LOG"
    echo "I_MPI_PIN=${I_MPI_PIN:-<unset>}" | tee -a "$LOG"
    echo "I_MPI_PIN_DOMAIN=${I_MPI_PIN_DOMAIN:-<unset>}" | tee -a "$LOG"
    echo "I_MPI_PIN_ORDER=${I_MPI_PIN_ORDER:-<unset>}" | tee -a "$LOG"
    echo "--- Команда ---" | tee -a "$LOG"
    echo "$2" | tee -a "$LOG"
    echo "--- Вывод ---" | tee -a "$LOG"
    eval "$2" 2>&1 | tee -a "$LOG"
    echo "" | tee -a "$LOG"
}

# ==========================================
# Серия 1: исходный код, блок 16×8×64, 100 итераций
# ==========================================

# --- Запуск 1: sequential ---
clean_env
run_test "Запуск 1: sequential" \
    "$BINARY_1 256 256 256 16 8 64 100 sequential"

# --- Запуск 2: pure_mpi 12 (n3=480) ---
clean_env
export OMP_NUM_THREADS=1
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0xFFF
export I_MPI_PIN_ORDER=compact
run_test "Запуск 2: pure_mpi 12 (n3=480)" \
    "mpirun -n 12 $BINARY_1 256 256 480 16 8 40 100 pure_mpi"

# --- Запуск 3: pure_mpi 2 (n3=256) ---
clean_env
export OMP_NUM_THREADS=1
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0x3F,0xFC0
export I_MPI_PIN_ORDER=compact
run_test "Запуск 3: pure_mpi 2 (n3=256)" \
    "mpirun -n 2 $BINARY_1 256 256 256 16 8 128 100 pure_mpi"

# --- Запуск 4: hybrid 2×6 (256³) ---
clean_env
export OMP_NUM_THREADS=6
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0x3F,0xFC0
export I_MPI_PIN_ORDER=compact
run_test "Запуск 4: hybrid 2×6 (256³)" \
    "mpirun -n 2 $BINARY_1 256 256 256 16 8 128 100 hybrid"

# --- Запуск 5: pure_omp 12 (256³) ---
clean_env
export OMP_NUM_THREADS=12
export OMP_PROC_BIND=close
export OMP_PLACES=cores
run_test "Запуск 5: pure_omp 12 (256³)" \
    "$BINARY_1 256 256 256 16 8 64 100 pure_omp"

# --- Запуск 6: pure_mpi 12 (n3=960) ---
clean_env
export OMP_NUM_THREADS=1
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0xFFF
export I_MPI_PIN_ORDER=compact
run_test "Запуск 6: pure_mpi 12 (n3=960)" \
    "mpirun -n 12 $BINARY_1 256 256 960 16 8 80 100 pure_mpi"

# --- Запуск 7: hybrid 2×6 (512³) ---
clean_env
export OMP_NUM_THREADS=6
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0x3F,0xFC0
export I_MPI_PIN_ORDER=compact
run_test "Запуск 7: hybrid 2×6 (512×512×256)" \
    "mpirun -n 2 $BINARY_1 512 512 256 16 8 128 100 hybrid"

# --- Запуск 0 (деградированный): pure_mpi 12 (n3=240) ---
clean_env
export OMP_NUM_THREADS=1
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0xFFF
export I_MPI_PIN_ORDER=compact
run_test "Запуск 0: pure_mpi 12 (n3=240, деградированный)" \
    "mpirun -n 12 $BINARY_1 256 256 240 16 8 20 100 pure_mpi"

# ==========================================
# Серия 2: адаптированный код, блок 64×64×64, 2000 итераций
# ==========================================

# --- Запуск 8: hybrid 1×8 (n3=480) ---
clean_env
export OMP_NUM_THREADS=8
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0xFF
export I_MPI_PIN_ORDER=compact
run_test "Запуск 8: hybrid 1×8 (n3=480, адаптированный)" \
    "mpirun -np 1 $BINARY_2 256 256 480 64 64 64 2000 hybrid"

# --- Запуск 9: hybrid 1×12 (n3=480) ---
clean_env
export OMP_NUM_THREADS=12
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0xFFF
export I_MPI_PIN_ORDER=compact
run_test "Запуск 9: hybrid 1×12 (n3=480, адаптированный)" \
    "mpirun -np 1 $BINARY_2 256 256 480 64 64 64 2000 hybrid"

# --- Запуск 10: hybrid 2×6 (n3=480) ---
clean_env
export OMP_NUM_THREADS=6
export OMP_PROC_BIND=close
export OMP_PLACES=cores
export I_MPI_PIN=on
export I_MPI_PIN_DOMAIN=0x3F,0xFC0
export I_MPI_PIN_ORDER=compact
run_test "Запуск 10: hybrid 2×6 (n3=480, адаптированный)" \
    "mpirun -np 2 $BINARY_2 256 256 480 64 64 64 2000 hybrid"

# ==========================================
echo "========================================" | tee -a "$LOG"
echo "Все запуски завершены: $(date '+%Y-%m-%d %H:%M:%S')" | tee -a "$LOG"
echo "Лог: $LOG" | tee -a "$LOG"
echo "========================================" | tee -a "$LOG"
